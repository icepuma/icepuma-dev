---
import { arcPath, polar, segments, tickPath } from "@/utils/dial";

export interface Props {
	days: Array<{ day: string; off: boolean }>;
}

const { days } = Astro.props;

// One turn is one week: Monday 00:00 sits at twelve o'clock, every tick on
// the rim is an hour, and the long ticks are midnights.
const hours = tickPath(200, 200, 186, 168, 4, (index) => index % 6 !== 0);
const quarters = tickPath(
	200,
	200,
	186,
	168,
	8,
	(index) => index % 6 === 0 && index % 24 !== 0,
);
const midnights = tickPath(200, 200, 186, 168, 14, (index) => index % 24 === 0);
const arcs = segments(days.length, 3).map((segment, index) => {
	const label = polar(200, 200, 218, segment.mid);
	return {
		...(days[index] ?? { day: "", off: true }),
		path: arcPath(200, 200, 160, segment.start, segment.end),
		left: `${Math.round(label.x * 25) / 100}%`,
		top: `${Math.round(label.y * 25) / 100}%`,
	};
});
---

<div class="dial" data-hud-dial aria-hidden="true">
	<div class="dial-tilt">
		<svg class="dial-layer dial-base" viewBox="0 0 400 400">
			<circle class="dial-rim" cx="200" cy="200" r="190" />
			<path class="dial-hours" d={hours} />
			<path class="dial-quarters" d={quarters} />
			<path class="dial-midnights" d={midnights} />
		</svg>
		<svg class="dial-layer dial-week" viewBox="0 0 400 400">
			{arcs.map(({ day, off, path }, index) => (
				<Fragment>
					<path class="dial-halo" data-day={day} d={path} />
					{off ? (
						<path class="dial-day dial-off" data-day={day} d={path} />
					) : (
						<path
							class="dial-day"
							data-day={day}
							d={path}
							pathLength="1"
							style={`--i: ${index}`}
						/>
					)}
				</Fragment>
			))}
			<g class="dial-now">
				<path d="M200 54V8" />
			</g>
		</svg>
		<svg class="dial-layer dial-core" viewBox="0 0 400 400">
			<g class="dial-spin">
				<circle cx="200" cy="200" r="116" />
			</g>
			<path class="dial-cross" d="M200 124v12M200 264v12M98 200h12M290 200h12" />
		</svg>
		<div class="dial-labels">
			{arcs.map(({ day, left, top }) => (
				<span data-day={day} style={`left: ${left}; top: ${top}`}>{day.toUpperCase()}</span>
			))}
		</div>
		<span class="dial-centre" data-hud-dial-day></span>
	</div>
</div>
