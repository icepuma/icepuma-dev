---
interface Props {
	href: string;
	class?: string;
	panel?: boolean;
}

const { href, class: className, panel = false } = Astro.props;
// A panel's corner holds a second arrow that slides in as the first runs out.
const arrows = panel ? 2 : 1;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={["control external-link", { panel }, className]}
>
	<slot />
	<span class:list={["link-endpoint", { "panel-arrow": panel }]}>
		{Array.from({ length: arrows }, () => (
			<svg
				class="external-arrow"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7 17 17 7M8.5 7H17v8.5" />
			</svg>
		))}
	</span>
	<span class="sr-only"> (opens in a new tab)</span>
</a>
