---
interface Props {
	href: string;
	class?: string;
	inspect?: boolean;
}

const { href, class: className, inspect = false } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={["control external-link", className]}
	data-inspect-link={inspect ? "" : undefined}
>
	<slot />
	<span class="link-endpoint" data-inspection-surface>
		{inspect && (
			<svg
				class="inspection-fallback"
				viewBox="0 0 80 80"
				fill="none"
				stroke="currentColor"
				stroke-width="1"
				aria-hidden="true"
			>
				<circle cx="40" cy="40" r="29" stroke-dasharray="9 9" />
				<circle cx="40" cy="40" r="21" stroke-dasharray="6 7" />
			</svg>
		)}
		<svg
			class="external-arrow"
			width="20"
			height="20"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			aria-hidden="true"
		>
			<path d="M6 18 18 6M6 6h12v12" />
		</svg>
	</span>
	<span class="sr-only"> (opens in a new tab)</span>
</a>
