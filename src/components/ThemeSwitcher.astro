---
const options = [
	{ value: "light", label: "Light" },
	{ value: "dark", label: "Dark" },
	{ value: "system", label: "System" },
] as const;
---

<div
	class="theme-switcher"
	data-theme-switcher
	role="group"
	aria-label="Color theme"
	hidden
>
	{
		options.map((option) => (
			<button
				class="theme-option control"
				data-theme-option={option.value}
				type="button"
				aria-pressed="false"
			>
				{option.label}
			</button>
		))
	}
</div>

<script>
	import type { Theme } from "@/utils/theme";
	import {
		loadTheme,
		setThemeWithTransition,
		setupThemeListener,
	} from "@/utils/theme";

	function initThemeSwitcher() {
		const switchers = Array.from(
			document.querySelectorAll<HTMLElement>("[data-theme-switcher]"),
		);
		const buttons = Array.from(
			document.querySelectorAll<HTMLButtonElement>(
				"button[data-theme-option]",
			),
		);

		if (switchers.length === 0 || buttons.length === 0) return;

		const syncState = (theme: Theme) => {
			for (const button of buttons) {
				const selected = button.dataset.themeOption === theme;
				button.setAttribute("aria-pressed", String(selected));
			}
		};

		for (const button of buttons) {
			button.addEventListener("click", () => {
				const theme = button.dataset.themeOption;
				if (
					theme === "light" ||
					theme === "dark" ||
					theme === "system"
				) {
					setThemeWithTransition(theme);
				}
			});
		}

		syncState(loadTheme());
		setupThemeListener(syncState);

		for (const switcher of switchers) {
			switcher.hidden = false;
		}
	}

	initThemeSwitcher();
</script>
