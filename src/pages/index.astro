---
import ExternalLink from "@/components/ExternalLink.astro";
import Nav from "@/components/Nav.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import WeekDial from "@/components/WeekDial.astro";
import MinimalLayout from "@/layouts/MinimalLayout.astro";
import { getCollection, render } from "astro:content";

const formatProjectDestination = (href: string) => {
	const destination = new URL(href);
	const pathname = destination.pathname.replace(/\/+$/, "");
	return `${destination.hostname}${pathname}`;
};

const stackEntries = (await getCollection("stack")).sort(
	(a, b) => Number(a.id) - Number(b.id),
);
const stackLinks: Record<string, string> = {
	Rust: "https://rust-lang.org/",
	TypeScript: "https://www.typescriptlang.org/",
	Kotlin: "https://kotlinlang.org/",
	Java: "https://dev.java/",
	Go: "https://go.dev/",
	Astro: "https://astro.build/",
	Ktor: "https://ktor.io/",
	Zed: "https://zed.dev/",
	Nanite: "https://github.com/icepuma/nanite",
	McFly: "https://github.com/cantino/mcfly",
	ripgrep: "https://github.com/BurntSushi/ripgrep",
	fd: "https://github.com/sharkdp/fd",
	cuenv: "https://cuenv.dev/",
	"Claude Code": "https://claude.com/product/claude-code",
	Codex: "https://openai.com/codex/",
	"Cloudflare Workers": "https://developers.cloudflare.com/workers/",
	Kubernetes: "https://kubernetes.io/",
	OpenTofu: "https://opentofu.org/",
	AWS: "https://aws.amazon.com/",
	PostgreSQL: "https://www.postgresql.org/",
	Bitwarden: "https://bitwarden.com/",
};
const calendarEntries = (await getCollection("calendar")).sort(
	(a, b) => Number(a.id) - Number(b.id),
);
const dialDays = calendarEntries.map((entry) => ({
	day: entry.data.day,
	off: !entry.data.url,
}));
const socialEntries = (await getCollection("socials")).sort(
	(a, b) => Number(a.id) - Number(b.id),
);

const projectEntries = await getCollection("projects");
const projects = await Promise.all(
	projectEntries
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (entry) => {
			const { Content } = await render(entry);
			return {
				data: entry.data,
				Content,
				destination: formatProjectDestination(entry.data.url),
			};
		}),
);

const musicLinks = [
	{
		name: "Tortuga Room",
		url: "https://www.youtube.com/@tortugaroom",
		genre: "Electronic",
		description:
			"Seoul-based mix platform with a loose underground-party feel, sharing DJ sessions that move between deep, psychedelic, and more atmospheric electronic sets.",
	},
	{
		name: "Yoyaku Record Store",
		url: "https://www.youtube.com/@yoyakurecordstore",
		genre: "Minimal",
		description:
			"Paris record store and label hub focused on electronic music, pairing a large vinyl catalog with mixes, artist sessions, and record culture from its 18th arrondissement base.",
	},
	{
		name: "EPHIMERA Tulum",
		url: "https://www.youtube.com/@EPHIMERATulum",
		genre: "Organic house",
		description:
			"Tulum-born audio-visual project streaming live DJ sets from natural locations and pushing the electronic sound of the Mexican Caribbean outward.",
	},
	{
		name: "RE: ANALOG",
		url: "https://www.youtube.com/@REANALOG",
		genre: "Disco",
		description:
			"Vinyl-centered channel and studio pairing improvised listening sessions with guest DJ sets, record culture, and a warm crate-digging atmosphere.",
	},
	{
		name: "Stil vor Talent",
		url: "https://www.youtube.com/@StilvorTalentTv",
		genre: "House",
		description:
			"Berlin label and event platform sharing artist releases, DJ clips, and dancefloor moments from its house-leaning electronic orbit.",
	},
	{
		name: "Yuna Room",
		url: "https://www.youtube.com/@Twilight441",
		genre: "Deep house",
		description:
			"Playlist-and-mix channel moving from deep house into softer late-night selections, including pop, R&B, and groove-heavy listening sessions.",
	},
	{
		name: "L'atelier de Musique",
		url: "https://www.youtube.com/@Latelier__de__Musique",
		genre: "Jazz-funk",
		description:
			"Record-driven channel built around themed vinyl episodes that drift through psychedelic soul, disco, jazz-funk, and other dusty global grooves.",
	},
	{
		name: "European Metal Channel",
		url: "https://www.youtube.com/@EuropeanMetalChannelOfficial",
		genre: "Metal",
		description:
			"Long-running curation channel spotlighting new European metal releases, scene roundups, and country-spanning band selections.",
	},
] as const;
---

<MinimalLayout
	title="icepuma.dev"
	description="Principal Engineer at Dataciders GmbH — Berlin, Germany"
>
	<a href="#main" class="skip-link">Skip to content</a>
	<header class="site-header">
		<div class="header-inner page-width">
			<a class="brand control" href={import.meta.env.BASE_URL} data-back-to-top aria-label="icepuma.dev, back to top">
				icepuma.dev
			</a>
			<Nav />
			<ThemeSwitcher />
		</div>
	</header>

	<main class="page-width" id="main" tabindex="-1">
		<div class="hero">
			<svg class="hero-grid" aria-hidden="true">
				<defs>
					<pattern id="hero-grid-mark" width="48" height="48" patternUnits="userSpaceOnUse">
						<path d="M24 20v8M20 24h8" />
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#hero-grid-mark)" />
			</svg>
			<div class="identity">
				<h1>Stefan Ruzitschka</h1>
				<p>
					<span class="identity-role">Principal Engineer at <ExternalLink href="https://dataciders.com/" class="employer-link">Dataciders GmbH</ExternalLink></span>
					<span class="identity-location">Berlin, Germany</span>
				</p>
			</div>
			<div class="hero-readout-slot">
				<dl class="hero-readout" data-hud-readout hidden>
					<div>
						<dt>Berlin</dt>
						<dd><time class="decode" data-hud-clock></time> <span data-hud-zone></span></dd>
					</div>
					<div>
						<dt>Today</dt>
						<dd data-hud-today></dd>
					</div>
				</dl>
			</div>
			<WeekDial days={dialDays} />
		</div>

		<section class="page-section projects-section" id="projects" aria-labelledby="projects-heading" tabindex="-1">
			<SectionHeading title="Projects" sub="開発" intro="Things I build and maintain." />
			<ul class="project-list" role="list">
				{projects.map(({ data, Content, destination }) => (
					<li>
						<ExternalLink href={data.url} class="project-row" panel>
							<h3>{data.name}</h3>
							<div class="project-description"><Content /></div>
							<p class="project-destination">
								{destination.split("/").map((part, index) => (
									<Fragment>{index > 0 && "/"}{index > 0 && <wbr />}{part}</Fragment>
								))}
							</p>
						</ExternalLink>
					</li>
				))}
			</ul>
		</section>

		<section class="page-section" id="about" aria-labelledby="about-heading" tabindex="-1">
			<SectionHeading title="About" sub="経歴" />
			<p class="about-copy">
				Principal Engineer with 15+ years of
				experience shipping end-to-end. Specializing in
				high-reliability systems, platform engineering, and
				monolith-to-microservices migrations.
			</p>
		</section>

		<section class="page-section" id="stack" aria-labelledby="stack-heading" tabindex="-1">
			<SectionHeading title="Stack" sub="使用技術" />
			<dl class="stack-list">
				{stackEntries.map((entry) => (
					<div class="stack-row">
						<dt>{entry.data.category}</dt>
						<dd>
							<ul class="stack-tools">
								{entry.data.items.map((item) => (
									<li><ExternalLink href={stackLinks[item]} class="stack-link">{item}</ExternalLink></li>
								))}
							</ul>
						</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="page-section" id="calendar" aria-labelledby="calendar-heading" tabindex="-1">
			<SectionHeading title="Calendar" sub="週間予定" intro="My weekly open-source schedule — what I work on and when." />
			<dl class="calendar-list">
				{calendarEntries.map((entry) => (
					<div class="calendar-row" data-day={entry.data.day} data-focus={entry.data.focus}>
						<dt>{entry.data.day}</dt>
						<dd>
							{entry.data.url ? (
								<ExternalLink href={entry.data.url} class="calendar-link">{entry.data.focus}</ExternalLink>
							) : <span class="calendar-off">{entry.data.focus}</span>}
						</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="page-section" id="music" aria-labelledby="music-heading" tabindex="-1">
			<SectionHeading title="Music" sub="音楽" intro="Channels and record spaces worth keeping in rotation." />
			<ul class="music-list" role="list">
				{musicLinks.map((link) => (
					<li>
						<ExternalLink href={link.url} class="music-row" panel>
							<div class="music-copy">
								<div class="music-title"><h3>{link.name}</h3><span class="music-genre">{link.genre}</span></div>
								<p>{link.description}</p>
							</div>
						</ExternalLink>
					</li>
				))}
			</ul>
		</section>

		<section class="page-section" id="social" aria-labelledby="social-heading" tabindex="-1">
			<SectionHeading title="Social" sub="連絡先" intro="Where to find me online." />
			<ul class="social-list" role="list">
				{socialEntries.map((entry) => (
					<li>
						<ExternalLink href={entry.data.url} class="social-row" panel>
							<div class="social-copy">
								<span class="social-platform">{entry.data.platform}</span>
								<span class="social-handle">{entry.data.handle}</span>
							</div>
						</ExternalLink>
					</li>
				))}
			</ul>
		</section>
	</main>

	<footer class="site-footer page-width">
		<p>icepuma.dev — {new Date().getFullYear()}</p>
		<a class="control back-to-top" href={import.meta.env.BASE_URL} data-back-to-top>Back to top <svg class="external-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg></a>
	</footer>
</MinimalLayout>

<script>
	import { initDialTilt, initHudClock } from "@/utils/hud";
	import {
		initAttentionLock,
		initBackToTop,
		initHeaderState,
		initSectionNavigation,
	} from "@/utils/navigation";
	initHudClock();
	initBackToTop();
	initHeaderState();
	initSectionNavigation();
	initAttentionLock();
	initDialTilt();
	// iOS only applies :active press styles once a touch listener exists.
	document.addEventListener("touchstart", () => {}, { passive: true });
	const header = document.querySelector<HTMLElement>(".site-header");
	if (header) {
		new ResizeObserver(() => {
			document.documentElement.style.setProperty("--header-height", `${header.offsetHeight}px`);
		}).observe(header);
	}
</script>
